[gd_resource type="Resource" script_class="ItemDef" format=3]

[ext_resource type="Script" path="res://scripts/items/item_def.gd" id="1_item"]
[ext_resource type="Script" path="res://scripts/stats/stat_modifier_def.gd" id="2_modifier"]

[sub_resource type="Resource" id="StatModifierDef_damage"]
script = ExtResource("2_modifier")
stat = &"damage"
op = 1
value = 0.4

[sub_resource type="Resource" id="StatModifierDef_fire_rate"]
script = ExtResource("2_modifier")
stat = &"fire_rate"
op = 1
value = -0.2

[resource]
script = ExtResource("1_item")
id = &"lente_de_foco"
display_name = "Lente de Foco"
description = "Cada tiro ganha peso, mas perde pressa."
rarity = 1
pools = Array[StringName]([&"treasure"])
max_stacks = 3
modifiers = Array[ExtResource("2_modifier")]([SubResource("StatModifierDef_damage"), SubResource("StatModifierDef_fire_rate")])
