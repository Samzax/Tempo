[gd_resource type="Resource" script_class="ItemDef" format=3]

[ext_resource type="Script" path="res://scripts/items/item_def.gd" id="1_item"]
[ext_resource type="Script" path="res://scripts/items/effect_def.gd" id="2_effect"]
[ext_resource type="Script" path="res://scripts/items/modify_stat_action.gd" id="3_action"]

[sub_resource type="Resource" id="ModifyStatAction_damage"]
script = ExtResource("3_action")
stat = &"damage"
op = 1
value = 0.25
duration = 3.0

[sub_resource type="Resource" id="EffectDef_on_damaged"]
script = ExtResource("2_effect")
event = &"on_damaged"
chance = 1.0
action = SubResource("ModifyStatAction_damage")

[resource]
script = ExtResource("1_item")
id = &"vinganca"
display_name = "Vinganca"
description = "Dor recente torna cada resposta mais forte."
rarity = 1
pools = Array[StringName]([&"treasure"])
max_stacks = 3
effects = Array[ExtResource("2_effect")]([SubResource("EffectDef_on_damaged")])
