[gd_resource type="Resource" script_class="ItemDef" format=3]

[ext_resource type="Script" path="res://scripts/items/item_def.gd" id="1_item"]
[ext_resource type="Script" path="res://scripts/stats/stat_modifier_def.gd" id="2_modifier"]

[sub_resource type="Resource" id="StatModifierDef_damage"]
script = ExtResource("2_modifier")
stat = &"damage"
op = 1
value = 0.5

[sub_resource type="Resource" id="StatModifierDef_max_health"]
script = ExtResource("2_modifier")
stat = &"max_health"
op = 0
value = -1.0

[resource]
script = ExtResource("1_item")
id = &"reator_instavel"
display_name = "Reator Instavel"
description = "Potencia brutal cobra sua margem de seguranca."
rarity = 1
pools = Array[StringName]([&"treasure"])
max_stacks = 3
modifiers = Array[ExtResource("2_modifier")]([SubResource("StatModifierDef_damage"), SubResource("StatModifierDef_max_health")])
