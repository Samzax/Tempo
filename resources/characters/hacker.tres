[gd_resource type="Resource" script_class="CharacterDef" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/items/character_def.gd" id="1_character_def"]
[ext_resource type="Texture2D" path="res://assets/characters/hacker.svg" id="2_portrait"]
[ext_resource type="Script" path="res://scripts/stats/stat_modifier_def.gd" id="3_modifier"]

[sub_resource type="Resource" id="StatModifierDef_aim_tier"]
script = ExtResource("3_modifier")
