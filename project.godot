; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Tempo"
run/main_scene="res://scenes/main/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

InputControls="*res://scripts/input/input_controls.gd"
VideoSettings="*res://scripts/autoload/video_settings.gd"
GameState="*res://scripts/autoload/game_state.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"
Pools="*res://scripts/autoload/pools.gd"
StatCatalog="*res://scripts/autoload/stat_catalog.gd"
RunManager="*res://scripts/autoload/run_manager.gd"
ItemCatalog="*res://scripts/autoload/item_catalog.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=405
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/scale_mode="fractional"

[editor_plugins]

enabled=PackedStringArray("res://addons/gut/plugin.cfg")

